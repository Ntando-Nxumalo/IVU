<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavigation"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@android:color/white"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <!-- Home -->
    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">
        <ImageView
            android:id="@+id/ivNavHome"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/circle_outline"
            android:contentDescription="@string/nav_home" />
        <TextView
            android:id="@+id/tvNavHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_home"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Decks -->
    <LinearLayout
        android:id="@+id/navDecks"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">
        <ImageView
            android:id="@+id/ivNavDecks"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/circle_outline"
            android:contentDescription="@string/nav_decks" />
        <TextView
            android:id="@+id/tvNavDecks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_decks"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Journal -->
    <LinearLayout
        android:id="@+id/navJournal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">
        <ImageView
            android:id="@+id/ivNavJournal"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/circle_outline"
            android:contentDescription="@string/nav_journal" />
        <TextView
            android:id="@+id/tvNavJournal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_journal"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Me -->
    <LinearLayout
        android:id="@+id/navMe"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">
        <ImageView
            android:id="@+id/ivNavMe"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/circle_outline"
            android:contentDescription="@string/nav_profile" />
        <TextView
            android:id="@+id/tvNavMe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_profile"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>